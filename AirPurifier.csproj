<Project Sdk="Microsoft.NET.Sdk">

  <!--
    対象ゲームバージョン（BSTarget）ごとの出力先・マニフェスト。
    BSTarget は Directory.Build.props で Platform (BS1.40.8 / BS1.44.1) から決まる。
  -->
  <PropertyGroup>
    <OutputPath>bin\$(BSTarget)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(BSTarget)\$(Configuration)\</IntermediateOutputPath>
    <ManifestPath>Manifests\$(BSTarget)\manifest.json</ManifestPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BSIPA は末尾が .manifest.json の埋め込みリソースを探すため、名前は版によらず固定する -->
    <None Remove="Manifests\**" />
    <EmbeddedResource Include="Manifests\$(BSTarget)\manifest.json" LogicalName="AirPurifier.manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Main">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BeatSaberDir)\Libs\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= ビルド前チェック ================= -->
  <Target Name="AP_ValidateTarget" BeforeTargets="BeforeBuild">
    <Error Condition="'$(BSTarget)' != '1.40.8' AND '$(BSTarget)' != '1.44.1'"
           Text="Unsupported BSTarget '$(BSTarget)'. Use Platform BS1.40.8 or BS1.44.1." />
    <Error Condition="!Exists('$(ManifestPath)')"
           Text="Manifest not found: $(ManifestPath)" />

    <!-- 参照先のゲームフォルダが対象バージョンと一致するか（BeatSaberVersion.txt 例: 1.44.1_20239） -->
    <PropertyGroup>
      <_ApGameVersionFile>$(BeatSaberDir)\BeatSaberVersion.txt</_ApGameVersionFile>
      <_ApGameVersionRaw Condition="Exists('$(_ApGameVersionFile)')">$([System.IO.File]::ReadAllText('$(_ApGameVersionFile)').Trim())</_ApGameVersionRaw>
      <_ApGameVersion Condition="'$(_ApGameVersionRaw)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_ApGameVersionRaw)', '_.*$', ''))</_ApGameVersion>
    </PropertyGroup>
    <Error Condition="'$(_ApGameVersion)' != '' AND '$(_ApGameVersion)' != '$(BSTarget)'"
           Text="BeatSaberDir '$(BeatSaberDir)' is game version $(_ApGameVersion), but BSTarget is $(BSTarget). Point BeatSaberDir to a $(BSTarget) instance (see AirPurifier.csproj.user)." />
    <Warning Condition="'$(_ApGameVersion)' == ''"
             Text="BeatSaberVersion.txt was not found in BeatSaberDir '$(BeatSaberDir)'; the game version could not be verified." />
    <Message Importance="high" Text="AirPurifier: BSTarget=$(BSTarget), BeatSaberDir=$(BeatSaberDir)" />
  </Target>

</Project>
